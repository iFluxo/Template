{
  "name": "bot-template",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "BUILD_ENV=production bun run db:generate && bun run src/main.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:pull": "bunx prisma db pull",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "lint": "bunx biome lint .",
    "lint:fix": "bunx biome lint --write .",
    "format": "bunx biome format .",
    "format:fix": "bunx biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@types/bun": "^1.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@slipher/redis-adapter": "^0.0.5",
    "chalk": "^5.6.2",
    "prisma": "^7.0.1",
    "seyfert": "^4.0.0"
  }
}
